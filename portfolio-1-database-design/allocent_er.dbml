// Allocent MFB - ER model (DBML for dbdiagram.io)
// Status/role/type values are plain varchar here; CHECK constraints are added in schema.sql.

Table companies {
  company_id int [pk, increment]
  name varchar(150) [not null]
  rc_number varchar(20) [unique, not null, note: 'CAC registration number']
  email varchar(150) [unique, not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | SUSPENDED | CLOSED']
  created_at timestamptz [not null, default: `now()`]
}

Table departments {
  department_id int [pk, increment]
  company_id int [not null, ref: > companies.company_id]
  name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, name) [unique]
    (department_id, company_id) [unique, note: 'supports the same-company FK from staff']
  }
}

Table staff {
  staff_id int [pk, increment]
  company_id int [not null, ref: > companies.company_id]
  department_id int [note: 'NULL for company-wide roles such as ADMIN or FINANCE']
  full_name varchar(150) [not null]
  email varchar(150) [unique, not null]
  phone varchar(20)
  role varchar(20) [not null, note: 'ADMIN | FINANCE | MANAGER | STAFF']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | INACTIVE']
  created_at timestamptz [not null, default: `now()`]
}

Table company_accounts {
  account_id int [pk, increment]
  company_id int [not null, ref: > companies.company_id]
  account_number char(10) [unique, not null, note: '10-digit NUBAN']
  balance decimal(15,2) [not null, default: 0, note: 'must be >= 0']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | FROZEN | CLOSED']
  created_at timestamptz [not null, default: `now()`]
}

Table department_wallets {
  wallet_id int [pk, increment]
  department_id int [unique, not null, ref: - departments.department_id, note: 'one wallet per department']
  balance decimal(15,2) [not null, default: 0, note: 'must be >= 0']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | FROZEN']
  created_at timestamptz [not null, default: `now()`]
}

Table budget_allocations {
  allocation_id int [pk, increment]
  wallet_id int [not null, ref: > department_wallets.wallet_id]
  source_account_id int [not null, ref: > company_accounts.account_id]
  allocated_by int [not null, ref: > staff.staff_id, note: 'application rule: FINANCE or ADMIN (not a database constraint)']
  amount decimal(15,2) [not null, note: 'must be > 0']
  period_start date [not null]
  period_end date [not null, note: 'must be after period_start']
  allocated_at timestamptz [not null, default: `now()`]
}

Table vendors {
  vendor_id int [pk, increment]
  company_id int [not null, ref: > companies.company_id]
  name varchar(150) [not null]
  bank_name varchar(100) [not null]
  account_number char(10) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, bank_name, account_number) [unique]
  }
}

Table expense_requests {
  request_id int [pk, increment]
  wallet_id int [not null, ref: > department_wallets.wallet_id]
  requested_by int [not null, ref: > staff.staff_id]
  vendor_id int [not null, ref: > vendors.vendor_id]
  amount decimal(15,2) [not null, note: 'must be > 0']
  category varchar(30) [not null, note: 'e.g. TRAVEL | SOFTWARE | EQUIPMENT | FUEL | UTILITIES | OTHER']
  description text
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | APPROVED | REJECTED | PAID']
  created_at timestamptz [not null, default: `now()`]
}

Table approvals {
  approval_id int [pk, increment]
  request_id int [not null, ref: > expense_requests.request_id]
  approver_id int [not null, ref: > staff.staff_id]
  approval_level smallint [not null, note: '1 = manager, 2 = finance; finance level for amounts > 100,000 is an application rule']
  decision varchar(10) [not null, note: 'APPROVED | REJECTED']
  comment text
  decided_at timestamptz [not null, default: `now()`]

  indexes {
    (request_id, approval_level) [unique]
  }
}

Table payments {
  payment_id int [pk, increment]
  request_id int [unique, not null, ref: - expense_requests.request_id, note: 'at most one payment per request']
  amount decimal(15,2) [not null, note: 'must be > 0']
  reference varchar(30) [unique, not null]
  status varchar(20) [not null, default: 'SUCCESSFUL', note: 'SUCCESSFUL | FAILED | REVERSED']
  paid_at timestamptz [not null, default: `now()`]
}

Table wallet_transactions {
  txn_id bigint [pk, increment]
  wallet_id int [not null, ref: > department_wallets.wallet_id]
  txn_type varchar(20) [not null, note: 'ALLOCATION | PAYMENT | TRANSFER_IN | TRANSFER_OUT | REVERSAL']
  amount decimal(15,2) [not null, note: 'must be > 0; direction comes from txn_type']
  balance_after decimal(15,2) [not null, note: 'must be >= 0']
  allocation_id int [ref: > budget_allocations.allocation_id, note: 'set when txn_type = ALLOCATION']
  payment_id int [ref: > payments.payment_id, note: 'set when txn_type = PAYMENT or REVERSAL']
  reference varchar(30) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table cards {
  card_id int [pk, increment]
  staff_id int [not null, ref: > staff.staff_id]
  wallet_id int [not null, ref: > department_wallets.wallet_id]
  masked_pan varchar(19) [not null, note: 'e.g. 5399 **** **** 1234; full card number never stored']
  spending_limit decimal(15,2) [not null, note: 'must be > 0']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | BLOCKED | EXPIRED']
  issued_at timestamptz [not null, default: `now()`]
}

Table receipts {
  receipt_id int [pk, increment]
  request_id int [not null, ref: > expense_requests.request_id]
  file_path varchar(255) [not null, note: 'file kept in object storage; DB stores the path only']
  uploaded_at timestamptz [not null, default: `now()`]
}

// Multi-tenant rule (fk_staff_dept_same_company): a staff member's department
// must belong to the staff member's own company.
Ref fk_staff_dept_same_company: staff.(department_id, company_id) > departments.(department_id, company_id)
